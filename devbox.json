{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.18.4/.schema/devbox.schema.json",
  "include": ["path:./devbox/molecule"],
  "env": {
    "CLAUDE_CONFIG_DIR": "$DEVBOX_PROJECT_ROOT/.claude"
  },
  "packages": {
    "just": "latest",
    "tomlq": "latest",
    "jq": "latest",
    "actionlint": "latest"
  },
  "shell": {
    "init_hook": ["alias make='just'"]
  }
}
